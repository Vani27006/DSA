class Solution {
    public int[] findSubtreeSizes(int[] parent, String s) {
        int n = parent.length;
        List<Integer>[] adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }
        for (int i = 1; i < n; i++) {
            adj[parent[i]].add(i);
        }
        int[] newParent = new int[n];
        int[] last = new int[26];
        int[] old = new int[n];
        int[] ans = new int[n];

        Arrays.fill(last, -1);
        Arrays.fill(ans, 1);

        List<Integer> order = new ArrayList<>();
        Stack<Integer> st = new Stack<>();

        st.push(0);

        while (!st.isEmpty()) {
            int x = st.pop();
            if (x < 0) {
                int u = -x - 1;
                last[s.charAt(u) - 'a'] = old[u];
                continue;
            }
            int u = x;
            int c = s.charAt(u) - 'a';

            old[u] = last[c];

            if (last[c] == -1) {
                newParent[u] = parent[u];
            } else {
                newParent[u] = last[c];
            }

            last[c] = u;

            order.add(u);
            st.push(-u - 1);

            for (int i = adj[u].size() - 1; i >= 0; i--) {
                st.push(adj[u].get(i));
            }
        }
        for (int i = order.size() - 1; i >= 0; i--) {
            int u = order.get(i);

            if (newParent[u] != -1) {
                ans[newParent[u]] += ans[u];
            }
        }
        return ans;
    }
}
