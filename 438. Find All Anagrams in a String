class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        int[] a=new int[26];
       for(int i=0;i<p.length();i++){
        char ch=p.charAt(i);
          a[ch-'a']++;
       }
       int[] b=new int[26];
       List<Integer> res=new ArrayList<>();
       int l=0;
       int k=p.length();
       for(int r=0;r<s.length();r++){
        char chr=s.charAt(r);
         b[chr-'a']++;
         if(r-l+1==k){
            if(Arrays.equals(a,b)){
                res.add(l);
            }
            char chl=s.charAt(l);
                b[chl-'a']--;
                l++;
         }
       }
      return res;
    }
}
