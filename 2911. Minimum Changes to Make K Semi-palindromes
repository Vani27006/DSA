class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        int[][] cost = new int[n][n];

        for (int l = 0; l < n; l++) {
            for (int r = l + 1; r < n; r++) {
                cost[l][r] = Integer.MAX_VALUE;

                int len = r - l + 1;

                for (int d = 1; d < len; d++) {
                    if (len % d != 0) {
                        continue;
                    }

                    int changes = 0;
                    int parts = len / d;

                    for (int j = 0; j < d; j++) {
                        for (int a = 0; a < parts / 2; a++) {
                            int x = l + j + a * d;
                            int y = l + j + (parts - 1 - a) * d;

                            if (s.charAt(x) != s.charAt(y)) {
                                changes++;
                            }
                        }
                    }

                    cost[l][r] = Math.min(cost[l][r], changes);
                }
            }
        }

        int INF = 1000000000;
        int[][] dp = new int[n + 1][k + 1];

        for (int i = 0; i <= n; i++) {
            java.util.Arrays.fill(dp[i], INF);
        }

        dp[0][0] = 0;

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= k; j++) {
                for (int p = 0; p <= i - 2; p++) {
                    if (dp[p][j - 1] != INF) {
                        dp[i][j] = Math.min(
                            dp[i][j],
                            dp[p][j - 1] + cost[p][i - 1]);
                    }
                }
            }
        }
        return dp[n][k];
    }
}
