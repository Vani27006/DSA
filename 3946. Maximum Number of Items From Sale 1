class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;

        int[] bonus = new int[n];
        for (int i = 0; i < n; i++) {
            int f = items[i][0];
            for (int j = 0; j < n; j++) {
                if (i != j && items[j][0] % f == 0) {
                    bonus[i]++;
                }
            }
        }
        int[] dp = new int[budget + 1];
        for (int i = 0; i < n; i++) {
            int cost = items[i][1];
            int first = 1 + bonus[i];
            int[] ndp = dp.clone();
            for (int b = cost; b <= budget; b++) {
                ndp[b] = Math.max(ndp[b],
                                  dp[b - cost] + first);
            }
            for (int b = cost; b <= budget; b++) {
                ndp[b] = Math.max(ndp[b],
                                  ndp[b - cost] + 1);
            }

            dp = ndp;
        }
        int ans = 0;
        for (int x : dp) {
            ans = Math.max(ans, x);
        }
        return ans;
    }
}
